{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "MediGuard AI (Dev Server)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "console": "integratedTerminal",
      "restart": true,
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "MediGuard AI (Python/Streamlit)",
      "type": "python",
      "request": "launch",
      "module": "streamlit",
      "args": ["run", "MediGuard_AI/app.py"],
      "console": "integratedTerminal"
    }
  ]
}
